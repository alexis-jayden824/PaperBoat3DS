; PaperBoat3DS M10 streamed graphics-contract vertex shader.

.fvec projection[4]

.constf constants(0.0, 1.0, -1.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex0 v1
.alias intex1 v2
.alias inclr v3

.proc main
    mov r0, inpos

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    mov outtc0, intex0
    mov outtc1, intex1
    mov outclr, inclr
    end
.end
