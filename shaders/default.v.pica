; Clip-space passthrough. Projection is applied in the Fast3D interpreter.
; Syntax matches picasso in the pinned 3ds-dev image (no .version directive).

.constf kconst(0.0, 1.0, -1.0, 1.0)
.alias ones kconst.yyyy

.out outpos position
.out outclr color
.out outtex texcoord0

.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main
	mov outpos, inpos
	mov outclr, inclr
	mov outtex, intex
	end
.end
